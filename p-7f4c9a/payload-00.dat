<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow,noarchive,nosnippet,noimageindex">
  <meta name="theme-color" content="#09090b">
  <title>Privater Katalog</title>
  <style>
    *{box-sizing:border-box} body{margin:0;min-height:100vh;display:grid;place-items:center;padding:24px;color:#f7f7f8;background:radial-gradient(circle at 50% 0,rgba(124,58,237,.28),transparent 32rem),#09090b;font-family:Inter,system-ui,sans-serif}.box{width:min(100%,440px);padding:30px;border:1px solid rgba(255,255,255,.14);border-radius:24px;background:rgba(255,255,255,.055);box-shadow:0 30px 100px rgba(0,0,0,.55)}.dot{width:12px;height:12px;margin-bottom:22px;border-radius:50%;background:#b7ff45;box-shadow:0 0 24px #b7ff45}h1{margin:0 0 12px;font-size:2.15rem;letter-spacing:-.05em}p{margin:0 0 20px;color:#aaaab6;line-height:1.55}label{display:block;margin-bottom:7px;font-size:.78rem;font-weight:800}input{width:100%;min-height:48px;padding:0 13px;color:white;border:1px solid rgba(255,255,255,.18);border-radius:12px;background:#111116;font:inherit}button{width:100%;min-height:48px;margin-top:10px;border:0;border-radius:12px;color:#09090b;background:#b7ff45;font:inherit;font-weight:900;cursor:pointer}.error{min-height:1.2em;margin-top:13px;color:#ff6b9c;font-size:.8rem}.small{margin-top:18px;font-size:.72rem;color:#71717d}
  </style>
</head>
<body>
  <main class="box">
    <div class="dot"></div>
    <h1>Privater Katalog</h1>
    <p id="status">Der vollständige Einladungslink öffnet den Katalog automatisch.</p>
    <div id="manual">
      <label for="key">Zugangsschlüssel</label>
      <input id="key" autocomplete="off" spellcheck="false" placeholder="Schlüssel einfügen">
      <button id="open" type="button">Katalog öffnen</button>
    </div>
    <div class="error" id="error"></div>
    <div class="small">Der Schlüssel bleibt ausschließlich in deinem Browser und wird nicht an den Server übertragen.</div>
  </main>
  <script>
    const payload = "