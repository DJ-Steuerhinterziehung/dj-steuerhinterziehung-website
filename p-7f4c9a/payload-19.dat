";
    const iv = "kYN7YM/3uutRJqB5";
    const decode = value => Uint8Array.from(atob(value.replace(/-/g,"+").replace(/_/g,"/")), c => c.charCodeAt(0));
    const decode64 = value => Uint8Array.from(atob(value), c => c.charCodeAt(0));
    async function unlock(rawKey){
      const error = document.getElementById("error");
      error.textContent = "";
      try{
        const keyBytes = decode(rawKey.trim());
        if(keyBytes.length !== 32) throw new Error("bad key");
        const key = await crypto.subtle.importKey("raw", keyBytes, "AES-GCM", false, ["decrypt"]);
        const plain = await crypto.subtle.decrypt({name:"AES-GCM",iv:decode64(iv)}, key, decode64(payload));
        const html = new TextDecoder().decode(plain);
        document.open(); document.write(html); document.close();
      }catch{
        error.textContent = "Der Link oder Schlüssel ist unvollständig.";
      }
    }
    const hashKey = location.hash.slice(1);
    if(hashKey){
      document.getElementById("manual").hidden = true;
      document.getElementById("status").textContent = "Katalog wird entschlüsselt …";
      unlock(hashKey);
    }
    document.getElementById("open").addEventListener("click",()=>unlock(document.getElementById("key").value));
    document.getElementById("key").addEventListener("keydown",event=>{if(event.key==="Enter") unlock(event.currentTarget.value)});
  </script>
</body>
</html>